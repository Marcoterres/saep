-- VIEWS DE RELATÓRIO E PAINEL

-- Visão geral para a tela inicial do sistema
CREATE OR REPLACE VIEW vw_painel_principal AS
SELECT 
    c.nome AS colaborador,
    t.titulo AS tarefa,
    cat.nome AS categoria,
    t.prazo_entrega,
    t.status
FROM tarefas t
JOIN colaboradores c ON t.id_colaborador = c.id_colaborador
JOIN categorias cat ON t.id_categoria = cat.id_categoria;

-- Visão ordenada por urgência de prazo e cálculo de dias restantes
CREATE OR REPLACE VIEW vw_cronograma_prazos AS
SELECT 
    t.titulo AS tarefa,
    t.prazo_entrega,
    (t.prazo_entrega - CURRENT_DATE) AS dias_restantes,
    t.status,
    c.nome AS responsavel
FROM tarefas t
JOIN colaboradores c ON t.id_colaborador = c.id_colaborador
ORDER BY t.prazo_entrega ASC;
